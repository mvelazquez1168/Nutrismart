# ─────────────────────────────────────────────────────────────
#  NutriSmart — Variables de entorno de producción
#  Copia este archivo como .env.prod en el servidor y rellena
#  cada valor. NUNCA subas .env.prod al repositorio.
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL (NutriSmart) ──────────────────────────────────
POSTGRES_DB=nutrismart
POSTGRES_USER=nutrismart
POSTGRES_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ── PostgreSQL (Keycloak — misma instancia, base separada) ───
#
# Keycloak persiste su realm AQUI, no en la base H2 embebida. Es lo que
# hace que el realm —clientes, roles, mappers y los usuarios con sus
# contraseñas— sobreviva a recrear el contenedor. Keycloak no exporta
# hashes de contraseña, así que un realm perdido no se restaura: se
# vuelve a montar a mano, usuario por usuario.
#
# **Bases separadas, no esquemas.** Así una migración de NutriSmart no
# puede tocar las tablas de Keycloak, y un `drop` de la de Keycloak no se
# lleva el expediente clínico. `init-db.sh` crea esta base y su usuario
# al primer arranque del volumen, leyendo estas tres variables.
#
# Las leen DOS servicios —`db` para crear la base y `keycloak` para
# conectarse—, y por eso viven solo aquí: tenerlas en un .sql aparte
# dejaba dos sitios con la misma contraseña, y al rellenar uno solo
# Keycloak no arrancaba y con él se quedaban abajo la API y los dos
# frontends.
#
# No hay `KC_DB_URL`: el compose usa la forma descompuesta
# (`KC_DB_URL_HOST`, `KC_DB_URL_PORT`, `KC_DB_URL_DATABASE`), que es
# equivalente y no obliga a citar un JDBC entero en una variable. `KC_DB`
# tampoco está aquí porque no es una decisión de despliegue: vale
# `postgres` y está fijo en el compose.
KC_DB_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# ── Keycloak ─────────────────────────────────────────────────
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
KEYCLOAK_REALM=nutrismart

# Cliente que usa la app PROFESIONAL (lo lee build-and-push.sh y lo
# incrusta en el bundle como VITE_KEYCLOAK_CLIENT_ID).
KEYCLOAK_CLIENT_ID=nutrismart-web
# Cliente que usa la app del PACIENTE. Es otro cliente del realm, no el
# mismo: la app lo lee como VITE_KEYCLOAK_CLIENT_ID_PACIENTE.
KEYCLOAK_CLIENT_ID_PACIENTE=nutrismart-patient

# A quien va dirigido el token. La API EXIGE que el claim 'aud' lo
# nombre; si no coincide, todas las peticiones responden 401.
KEYCLOAK_AUDIENCE=nutrismart-api

# ── Integraciones opcionales ─────────────────────────────────
# Si se dejan vacias, la plataforma arranca igual y solo esa funcion
# responde 503. El acceso a expedientes y agenda NUNCA se bloquea por
# el estado de una de estas.

# Correo saliente (invitaciones de paciente, recordatorios de cita).
# El remitente por defecto es el sandbox de Resend, que solo entrega a
# direcciones verificadas: para invitar a pacientes reales hace falta un
# dominio propio verificado.
RESEND_API_KEY=
RESEND_FROM=

# IA (sugerencias asistidas). Sin clave, esas funciones responden 503.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=

# Wearables (RPM-01). La clave son 32 bytes en hexadecimal (64 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Una clave mal copiada es PEOR que ninguna: cifraria mal solo a veces.
WEARABLE_ENCRYPTION_KEY=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Imagen del panel de la pantalla de acceso del profesional (opcional).
# Se INCRUSTA en el bundle durante el build.
VITE_LOGIN_IMAGE_URL=

# ── ECR (registro de imágenes AWS) ───────────────────────────
# Formato: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=TU_ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

# ── AWS (para el script de deploy) ───────────────────────────
AWS_REGION=us-east-1
