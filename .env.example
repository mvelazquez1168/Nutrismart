# NutriSmart · variables de entorno (ejemplo). Copia a .env y completa.

# --- Base de datos (propia de NutriSmart) ---
DB_USER=nutrismart
DB_PASSWORD=changeme
DATABASE_URL=postgres://nutrismart:changeme@db:5432/nutrismart

# --- API ---
API_PORT=4000
NODE_ENV=development

# --- Keycloak (reutiliza la instalación EXISTENTE, con un realm NUEVO) ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=nutrismart
KEYCLOAK_CLIENT_ID=nutrismart-api
KEYCLOAK_CLIENT_SECRET=
# Red Docker donde ya corre el contenedor de Keycloak (para reutilizarlo).
# Ajusta al nombre real de la red del compose de Vetline (docker network ls).
KEYCLOAK_NETWORK=vetline_default

# --- Frontend ---
FRONTEND_PRO_URL=http://localhost:5173
FRONTEND_PAT_URL=http://localhost:5174

# --- Integraciones (por configurar) ---
TILOPAY_API_KEY=
CLAUDE_API_KEY=
RESEND_API_KEY=
