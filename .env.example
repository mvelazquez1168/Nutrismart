# NutriSmart · variables de entorno (ejemplo). Copia a .env y completa.

# --- Base de datos (propia de NutriSmart) ---
DB_USER=nutrismart
DB_PASSWORD=changeme
# Forma para DEV EN EL HOST (npm run dev): Postgres publicado en 5434.
# El 5432 y el 5433 ya los ocupan servicios PostgreSQL nativos de Windows.
# Dentro de Docker el compose la sobrescribe con db:5432.
DATABASE_URL=postgres://nutrismart:changeme@localhost:5434/nutrismart

# --- API ---
# Puerto para DEV EN EL HOST. El 4000 lo ocupa vetplatform-backend-1,
# que lo publica desde Docker. Dentro del contenedor el compose lo
# sobrescribe a 4000, que es el lado interno del mapeo 4001:4000.
API_PORT=4001
NODE_ENV=development

# --- Keycloak (reutiliza la instalación EXISTENTE, con un realm NUEVO) ---
KEYCLOAK_REALM=nutrismart
# URL pública: la usa el NAVEGADOR (la SPA). localhost, no el hostname de Docker.
KEYCLOAK_URL_PUBLIC=http://localhost:8080
# Issuer LITERAL del token (login contra localhost). La API lo compara carácter
# por carácter; si no coincide, 401.
# Issuer(s) aceptados en el claim 'iss', separados por coma.
#
# Es una lista porque el navegador firma con la direccion por la que
# llego a Keycloak: desde un movil de la red local eso es la IP de la
# maquina, no localhost, y con un solo valor todas sus peticiones darian
# 401. Ver docs/PRUEBAS-MOVIL.md.
KEYCLOAK_ISSUER=http://localhost:8080/realms/nutrismart
# Ruta de RED para descargar las llaves públicas. Forma para DEV EN EL HOST;
# dentro de Docker el compose la sobrescribe con keycloak:8080.
# (El ISSUER de arriba NO cambia nunca: siempre localhost.)
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/nutrismart/protocol/openid-connect/certs
# La API exige que el token la nombre como destinatario (claim 'aud').
KEYCLOAK_AUDIENCE=nutrismart-api
# Cliente público (PKCE) que usa la app profesional.
KEYCLOAK_CLIENT_ID_WEB=nutrismart-web
# Red Docker donde YA corre el contenedor de Keycloak (verificado con docker inspect keycloak).
KEYCLOAK_NETWORK=postgres_default

# --- Service account del Admin API ---
# Lo que permite que la API cree usuarios en Keycloak por su cuenta: el
# panel de plataforma y las altas de equipo con cuenta incluida.
#
# Es OPCIONAL. Sin estas dos ultimas variables la plataforma arranca igual:
# las altas vuelven al flujo manual (ficha en 'invitacion_pendiente') y el
# panel de plataforma responde 503 explicando que falta. La regla de oro de
# no bloquear el acceso clinico aplica tambien aqui.
#
# El cliente y su rol `manage-users` ya vienen en el export del realm
# (infra/keycloak/realm-nutrismart.json), asi que un realm importado de
# cero funciona sin tocar nada en Keycloak.
#
# Forma para DEV EN EL HOST; dentro de Docker el compose la sobrescribe con
# keycloak:8080, igual que con JWKS. El valor por defecto del codigo es el
# interno, asi que ejecutar la API en el host SIN esta linea falla.
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_SVC_CLIENT=nutrismart-backend
# Secret de DESARROLLO, el mismo que trae el export del realm. En
# produccion va otro, generado en Keycloak -> Clients -> Credentials.
KEYCLOAK_SVC_SECRET=dev-only-nutrismart-backend-secret

# --- Usuario de prueba (solo desarrollo) ---
# 'sub' del usuario de prueba del realm; el seed lo sustituye en
# ${DEV_KEYCLOAK_SUB} para rellenar profesional.keycloak_user_id.
# OJO: Keycloak 26 genera el id del usuario y NO acepta uno fijado, asi que
# este valor cambia cada vez que se recrea el usuario. Si recreas el realm,
# pide un token y actualiza esta linea con el 'sub' nuevo.
DEV_KEYCLOAK_SUB=364f4a9b-8f08-4599-a848-68ade4fa48e0

# Segundo usuario, con rol 'nutricionista' (NO admin_clinica). Sin él no
# se puede probar la visibilidad por profesional: Ana es administradora
# y ve toda la clínica igualmente.
DEV_KEYCLOAK_SUB_NUTRI=7c81373c-436e-4180-944e-19f74f0b10da

# --- Almacén de archivos clínicos ---
# Raíz donde se guardan informes de laboratorio y adjuntos. En Docker es
# un volumen montado; los binarios NO van en Postgres.
# Vacío = ./datos/archivos en la raíz del repo (dev en el host).
ARCHIVOS_DIR=

# --- Frontend ---
FRONTEND_PRO_URL=http://localhost:5173
# App del paciente. Va en la misma lista de origenes permitidos (CORS).
FRONTEND_PAC_URL=http://localhost:5175
FRONTEND_PAT_URL=http://localhost:5175

# Vite SOLO expone al navegador las variables con prefijo VITE_. Las de
# arriba no llegan al front. Ojo: todo lo VITE_ acaba en el bundle y es
# publico — nunca pongas secretos aqui.
VITE_API_URL=http://localhost:4001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nutrismart
VITE_KEYCLOAK_CLIENT_ID=nutrismart-web

# --- Integraciones (por configurar) ---
TILOPAY_API_KEY=
CLAUDE_API_KEY=
RESEND_API_KEY=

# --- IA (opcional) ---------------------------------------------------
# Sin clave, la plataforma arranca igual: solo las funciones de IA
# responden 503. Nunca se bloquea el acceso clinico por el estado de la IA.
ANTHROPIC_API_KEY=
# Por defecto claude-haiku-4-5. Sube de modelo si la calidad no basta.
ANTHROPIC_MODELO=claude-haiku-4-5

# --- App del paciente (PAC) ------------------------------------------
# 5174 lo ocupa el frontend de Vetline en esta maquina: la app del
# paciente usa el 5175.
PAC_APP_URL=http://localhost:5175
# Cliente publico de Keycloak para la app del paciente (distinto del de
# la app profesional: otras URLs de retorno y otro rol).
VITE_KEYCLOAK_CLIENT_ID_PACIENTE=nutrismart-patient
# Correo saliente por Resend. Sin RESEND_API_KEY la invitacion se crea
# igual y el enlace se imprime en la consola de la API.
RESEND_API_KEY=
# Remitente. Por defecto usa el sandbox de Resend, que SOLO entrega a
# direcciones verificadas en la cuenta: sirve para probar entre nosotros,
# no para invitar a un paciente real.
#
# Para eso hace falta un dominio propio verificado en resend.com ->
# Domains. NutriSmart no puede usar el de Vetline: son dominios
# distintos y la verificacion es por dominio. Vale tambien un subdominio
# (mail.nutrismart.app) si comparten infraestructura.
RESEND_FROM=NutriSmart <noreply@nutrismart.app>

# Imagen del panel izquierdo de la pantalla de acceso. Vacia = color solido.
VITE_LOGIN_IMAGE_URL=

# ---- Wearables (RPM-01 y RPM-02). OPCIONAL ----
#
# Sin estas variables la API arranca igual y la seccion de dispositivos
# responde 503 diciendo que falta. Nunca bloquea el acceso clinico.
#
# Clave de cifrado de los tokens OAuth: 32 bytes hex (64 caracteres).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEARABLE_ENCRYPTION_KEY=

# https://dev.fitbit.com/apps
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# https://console.cloud.google.com  (habilitar Fitness API)
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=

# Basculas Withings — https://developer.withings.com/dashboard/
#
# Al dar de alta la aplicacion hay que registrar la direccion de vuelta
# EXACTA:  <APP_PUBLIC_URL>/api/paciente/wearables/withings/callback
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# Base publica desde la que se llega a la API: la usan las direcciones de
# vuelta de OAuth. En desarrollo con movil, la del proxy de Vite.
APP_PUBLIC_URL=
