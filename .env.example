# NutriSmart · variables de entorno (ejemplo). Copia a .env y completa.

# --- Base de datos (propia de NutriSmart) ---
DB_USER=nutrismart
DB_PASSWORD=changeme
# Forma para DEV EN EL HOST (npm run dev): Postgres publicado en 5434.
# El 5432 y el 5433 ya los ocupan servicios PostgreSQL nativos de Windows.
# Dentro de Docker el compose la sobrescribe con db:5432.
DATABASE_URL=postgres://nutrismart:changeme@localhost:5434/nutrismart

# --- API ---
# Puerto para DEV EN EL HOST. El 4000 lo ocupa vetplatform-backend-1,
# que lo publica desde Docker. Dentro del contenedor el compose lo
# sobrescribe a 4000, que es el lado interno del mapeo 4001:4000.
API_PORT=4001
NODE_ENV=development

# --- Keycloak (reutiliza la instalación EXISTENTE, con un realm NUEVO) ---
KEYCLOAK_REALM=nutrismart
# URL pública: la usa el NAVEGADOR (la SPA). localhost, no el hostname de Docker.
KEYCLOAK_URL_PUBLIC=http://localhost:8080
# Issuer LITERAL del token (login contra localhost). La API lo compara carácter
# por carácter; si no coincide, 401.
KEYCLOAK_ISSUER=http://localhost:8080/realms/nutrismart
# Ruta de RED para descargar las llaves públicas. Forma para DEV EN EL HOST;
# dentro de Docker el compose la sobrescribe con keycloak:8080.
# (El ISSUER de arriba NO cambia nunca: siempre localhost.)
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/nutrismart/protocol/openid-connect/certs
# La API exige que el token la nombre como destinatario (claim 'aud').
KEYCLOAK_AUDIENCE=nutrismart-api
# Cliente público (PKCE) que usa la app profesional.
KEYCLOAK_CLIENT_ID_WEB=nutrismart-web
# Red Docker donde YA corre el contenedor de Keycloak (verificado con docker inspect keycloak).
KEYCLOAK_NETWORK=postgres_default

# --- Usuario de prueba (solo desarrollo) ---
# 'sub' del usuario de prueba del realm; el seed lo sustituye en
# ${DEV_KEYCLOAK_SUB} para rellenar profesional.keycloak_user_id.
# OJO: Keycloak 26 genera el id del usuario y NO acepta uno fijado, asi que
# este valor cambia cada vez que se recrea el usuario. Si recreas el realm,
# pide un token y actualiza esta linea con el 'sub' nuevo.
DEV_KEYCLOAK_SUB=364f4a9b-8f08-4599-a848-68ade4fa48e0

# Segundo usuario, con rol 'nutricionista' (NO admin_clinica). Sin él no
# se puede probar la visibilidad por profesional: Ana es administradora
# y ve toda la clínica igualmente.
DEV_KEYCLOAK_SUB_NUTRI=7c81373c-436e-4180-944e-19f74f0b10da

# --- Almacén de archivos clínicos ---
# Raíz donde se guardan informes de laboratorio y adjuntos. En Docker es
# un volumen montado; los binarios NO van en Postgres.
# Vacío = ./datos/archivos en la raíz del repo (dev en el host).
ARCHIVOS_DIR=

# --- Frontend ---
FRONTEND_PRO_URL=http://localhost:5173
FRONTEND_PAT_URL=http://localhost:5174

# Vite SOLO expone al navegador las variables con prefijo VITE_. Las de
# arriba no llegan al front. Ojo: todo lo VITE_ acaba en el bundle y es
# publico — nunca pongas secretos aqui.
VITE_API_URL=http://localhost:4001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=nutrismart
VITE_KEYCLOAK_CLIENT_ID=nutrismart-web

# --- Integraciones (por configurar) ---
TILOPAY_API_KEY=
CLAUDE_API_KEY=
RESEND_API_KEY=

# --- IA (opcional) ---------------------------------------------------
# Sin clave, la plataforma arranca igual: solo las funciones de IA
# responden 503. Nunca se bloquea el acceso clinico por el estado de la IA.
ANTHROPIC_API_KEY=
# Por defecto claude-haiku-4-5. Sube de modelo si la calidad no basta.
ANTHROPIC_MODELO=claude-haiku-4-5
