{
  "name": "@nutrismart/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de NutriSmart (Node + TypeScript + Fastify + Postgres)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@types/nodemailer": "^8.0.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jose": "^5.9.6",
    "nodemailer": "^9.0.5",
    "pg": "^8.13.1",
    "puppeteer": "^25.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
