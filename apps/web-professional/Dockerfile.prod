# ============================================================
# App del nutricionista — imagen de PRODUCCIÓN (build estático + nginx)
#
# Contexto de build: la RAÍZ del repo. Aquí es imprescindible, no solo
# conveniente: la app importa @nutrismart/design-system, que es un
# workspace hermano y no existiría en un contexto limitado a
# apps/web-professional.
#
#   docker build -f apps/web-professional/Dockerfile.prod \
#     --build-arg VITE_API_URL=https://nutrismart.solutechit.com ... .
# ============================================================

# Mismo major que la API y que el compose de desarrollo. Ver la nota en
# apps/api/Dockerfile.prod sobre por qué no es node:20.
ARG NODE_VERSION=24-alpine

# ---------- build ----------
FROM node:${NODE_VERSION} AS build
WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web-professional/package.json apps/web-professional/
COPY apps/web-patient/package.json apps/web-patient/
COPY packages/design-system/package.json packages/design-system/

# El workspace de la API arrastra puppeteer, que descargaría ~180 MB de
# Chromium para construir un frontend que no lo usa.
ENV PUPPETEER_SKIP_DOWNLOAD=true

RUN npm ci

COPY tsconfig.base.json ./
COPY packages/design-system ./packages/design-system
COPY apps/web-professional ./apps/web-professional

# Las variables VITE_ se resuelven EN EL BUILD, no en runtime: Vite las
# incrusta en el bundle. Por eso llegan como ARG y no por env_file como
# en la API — pasarlas al contenedor en runtime no tendría ningún efecto.
#
# Consecuencia: cambiar de entorno (dev, staging, producción) exige
# reconstruir la imagen, no basta con reiniciarla.
#
# VITE_API_URL es el ORIGEN de la API, SIN /api al final. El cliente
# (src/api/client.ts) hace fetch(`${BASE}${ruta}`) y cada ruta ya empieza
# por /api/. Con ".../api" aquí, toda petición saldría a /api/api/me y
# respondería 404.
ARG VITE_API_URL
ARG VITE_KEYCLOAK_URL
ARG VITE_KEYCLOAK_REALM
ARG VITE_KEYCLOAK_CLIENT_ID
# Opcional: imagen del panel de la pantalla de acceso. Vacía = color sólido.
ARG VITE_LOGIN_IMAGE_URL

ENV VITE_API_URL=$VITE_API_URL \
    VITE_KEYCLOAK_URL=$VITE_KEYCLOAK_URL \
    VITE_KEYCLOAK_REALM=$VITE_KEYCLOAK_REALM \
    VITE_KEYCLOAK_CLIENT_ID=$VITE_KEYCLOAK_CLIENT_ID \
    VITE_LOGIN_IMAGE_URL=$VITE_LOGIN_IMAGE_URL

RUN npm run build -w @nutrismart/web-professional

# ---------- runtime ----------
FROM nginx:alpine AS runtime

# nginx.conf trae el fallback de SPA y las cabeceras de caché. No se
# escribe aquí en línea para no duplicar lo que ya usa el compose de
# desarrollo: un solo archivo, un solo comportamiento.
COPY apps/web-professional/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web-professional/dist /usr/share/nginx/html

EXPOSE 80
